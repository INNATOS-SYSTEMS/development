<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia de Formulario de Empleado -->
    <record id="view_employee_form_inherit_plows" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.plows</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Plows POS" name="plows_pos_employee">
                    <group>
                        <group string="Auditoría">
                            <field name="x_id_pos" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Acción para Empleados de POS -->
    <record id="action_plows_pos_employees" model="ir.actions.act_window">
        <field name="name">Personal</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('x_id_pos', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay personal sincronizado desde Plows POS.
            </p>
        </field>
    </record>
</odoo>
