<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="plows_pos_webhook_log_view_tree" model="ir.ui.view">
        <field name="name">plows.pos.webhook.log.tree</field>
        <field name="model">plows.pos.webhook.log</field>
        <field name="arch" type="xml">
            <list string="Bitácora de Webhooks Recibidos" decoration-info="state == 'pending'" decoration-success="state == 'processed'" decoration-warning="state == 'skipped'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="event_id"/>
                <field name="entity_type"/>
                <field name="entity_id"/>
                <field name="change_type"/>
                <field name="state"/>
                <field name="received_at"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="plows_pos_webhook_log_view_form" model="ir.ui.view">
        <field name="name">plows.pos.webhook.log.form</field>
        <field name="model">plows.pos.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Log de Webhook Recibido">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processed,skipped,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detalles del Evento">
                            <field name="event_id" readonly="1"/>
                            <field name="tenant_id" readonly="1"/>
                            <field name="entity_type" readonly="1"/>
                            <field name="entity_id" readonly="1"/>
                            <field name="change_type" readonly="1"/>
                        </group>
                        <group string="Tiempos y Auditoría">
                            <field name="received_at" readonly="1"/>
                            <field name="processed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Mensaje de Error" invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Payload JSON Crudo">
                        <field name="raw_payload" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="plows_pos_webhook_log_view_search" model="ir.ui.view">
        <field name="name">plows.pos.webhook.log.search</field>
        <field name="model">plows.pos.webhook.log</field>
        <field name="arch" type="xml">
            <search string="Buscar Webhooks">
                <field name="name"/>
                <field name="event_id"/>
                <field name="entity_type"/>
                <field name="entity_id"/>
                <filter string="Procesados" name="processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Duplicados Omitidos" name="skipped" domain="[('state', '=', 'skipped')]"/>
                <filter string="Fallidos" name="failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter string="Tipo de Entidad" name="group_entity_type" context="{'group_by': 'entity_type'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Operación" name="group_change_type" context="{'group_by': 'change_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_plows_pos_webhook_log_act" model="ir.actions.act_window">
        <field name="name">Bitácora de Webhooks</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">plows.pos.webhook.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="plows_pos_webhook_log_view_search"/>
    </record>

</odoo>
