<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista de Mapeo de Campos -->
    <record id="view_plows_pos_field_mapping_tree" model="ir.ui.view">
        <field name="name">plows.pos.field.mapping.tree</field>
        <field name="model">plows.pos.field.mapping</field>
        <field name="arch" type="xml">
            <list string="Mapeo de Propiedades POS ➔ Odoo" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="pos_catalog"/>
                <field name="json_key"/>
                <field name="json_key_desc"/>
                <field name="odoo_model_id" options="{'no_create': True}"/>
                <field name="odoo_field_id" options="{'no_create': True}"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="allow_create" widget="boolean_toggle"/>
                <field name="is_required"/>
                <field name="default_fallback"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario de Mapeo de Campos -->
    <record id="view_plows_pos_field_mapping_form" model="ir.ui.view">
        <field name="name">plows.pos.field.mapping.form</field>
        <field name="model">plows.pos.field.mapping</field>
        <field name="arch" type="xml">
            <form string="Configuración de Mapeo de Propiedad">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Origen API POS">
                            <field name="pos_catalog"/>
                            <field name="json_key"/>
                            <field name="json_key_desc"/>
                        </group>
                        <group string="Destino Odoo ORM">
                            <field name="odoo_model_id" options="{'no_create': True}"/>
                            <field name="odoo_field_id" options="{'no_create': True}"/>
                            <field name="is_active"/>
                            <field name="allow_create"/>
                            <field name="is_required"/>
                            <field name="default_fallback"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda / Filtros -->
    <record id="view_plows_pos_field_mapping_search" model="ir.ui.view">
        <field name="name">plows.pos.field.mapping.search</field>
        <field name="model">plows.pos.field.mapping</field>
        <field name="arch" type="xml">
            <search string="Buscar Mapeos">
                <field name="json_key"/>
                <field name="odoo_field_id"/>
                <field name="pos_catalog"/>
                <filter string="Activos" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('is_active', '=', False)]"/>
                <group>
                    <filter string="Catálogo POS" name="group_pos_catalog" context="{'group_by': 'pos_catalog'}"/>
                    <filter string="Modelo Odoo" name="group_odoo_model" context="{'group_by': 'odoo_model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana para Mapeo de Campos -->
    <record id="action_plows_pos_field_mapping" model="ir.actions.act_window">
        <field name="name">Mapeo de Propiedades</field>
        <field name="res_model">plows.pos.field.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_pos_catalog': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡No hay reglas de mapeo configuradas!
            </p>
            <p>
                Haz clic en el botón <strong>Cargar Predeterminados</strong> en la parte superior para inicializar automáticamente la correspondencia estándar de todos los catálogos.
            </p>
        </field>
    </record>
</odoo>
