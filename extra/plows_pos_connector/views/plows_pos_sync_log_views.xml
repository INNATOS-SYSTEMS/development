<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista de Logs de Sincronización -->
    <record id="view_plows_pos_sync_log_tree" model="ir.ui.view">
        <field name="name">plows.pos.sync.log.list</field>
        <field name="model">plows.pos.sync.log</field>
        <field name="arch" type="xml">
            <list string="Logs de Sincronización" create="0" delete="0"
                  decoration-danger="level == 'error'"
                  decoration-warning="level == 'warning'">
                <field name="job_id" options="{'no_create': True, 'no_open': False}"/>
                <field name="timestamp"/>
                <field name="level" widget="badge"
                       decoration-danger="level == 'error'"
                       decoration-warning="level == 'warning'"
                       decoration-info="level == 'info'"/>
                <field name="phase"/>
                <field name="message"/>
                <field name="record_ref"/>
            </list>
        </field>
    </record>

    <!-- Vista de Búsqueda de Logs -->
    <record id="view_plows_pos_sync_log_search" model="ir.ui.view">
        <field name="name">plows.pos.sync.log.search</field>
        <field name="model">plows.pos.sync.log</field>
        <field name="arch" type="xml">
            <search string="Buscar Logs">
                <field name="job_id"/>
                <field name="message"/>
                <field name="record_ref"/>
                <filter string="Errores" name="errors" domain="[('level','=','error')]"/>
                <filter string="Advertencias" name="warnings" domain="[('level','=','warning')]"/>
                <filter string="Info" name="info" domain="[('level','=','info')]"/>
                <separator/>
                <filter string="Catálogos" name="phase_catalogs" domain="[('phase','=','catalogs')]"/>
                <filter string="Cortes de Caja" name="phase_closures" domain="[('phase','=','closures')]"/>
                <filter string="Movimientos/Tickets" name="phase_movements" domain="[('phase','=','movements_tickets')]"/>
                <group>
                    <filter string="Job" name="group_by_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Nivel" name="group_by_level" context="{'group_by': 'level'}"/>
                    <filter string="Fase" name="group_by_phase" context="{'group_by': 'phase'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana para Logs -->
    <record id="action_plows_pos_sync_log" model="ir.actions.act_window">
        <field name="name">Logs de Sincronización</field>
        <field name="res_model">plows.pos.sync.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_plows_pos_sync_log_search"/>
        <field name="context">{'create': False, 'search_default_warnings': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay logs de sincronización registrados.
            </p>
            <p>
                Los logs se generan automáticamente durante la ejecución de los jobs de sincronización.
            </p>
        </field>
    </record>
</odoo>
