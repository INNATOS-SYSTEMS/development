<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia de Formulario de Ubicación de Stock -->
    <record id="view_location_form_inherit_plows" model="ir.ui.view">
        <field name="name">stock.location.form.inherit.plows</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='additional_info']" position="after">
                <group string="Conexión Plows POS" name="plows_pos_branch">
                    <field name="x_id_pos" readonly="1"/>
                    <field name="x_warehouse_code"/>
                    <field name="x_analytic_account_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Acción para Ubicaciones (Sucursales) POS -->
    <record id="action_plows_pos_locations" model="ir.actions.act_window">
        <field name="name">Almacenes</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_id_pos', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay sucursales asociadas en Plows POS.
            </p>
        </field>
    </record>
</odoo>
