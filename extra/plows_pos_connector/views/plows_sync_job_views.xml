<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List (Tree) -->
    <record id="view_plows_pos_sync_job_tree" model="ir.ui.view">
        <field name="name">plows.pos.sync.job.list</field>
        <field name="model">plows.pos.sync.job</field>
        <field name="arch" type="xml">
            <list string="Historial de Sincronización" decoration-danger="state == 'failed'" decoration-success="state == 'done'" decoration-info="state == 'running'">
                <field name="name"/>
                <field name="start_date" readonly="1"/>
                <field name="end_date" readonly="1"/>
                <field name="records_processed" sum="Total Sincronizados"/>
                <field name="records_failed" sum="Total Fallidos" decoration-danger="records_failed &gt; 0"/>
                <field name="state" widget="badge" decoration-danger="state == 'failed'" decoration-success="state == 'done'" decoration-info="state == 'running'"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_plows_pos_sync_job_kanban" model="ir.ui.view">
        <field name="name">plows.pos.sync.job.kanban</field>
        <field name="model">plows.pos.sync.job</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="false" group_create="false" group_edit="false" group_delete="false">
                <field name="name"/>
                <field name="start_date"/>
                <field name="records_processed"/>
                <field name="records_failed"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <span>Fecha: </span><field name="start_date"/>
                                </div>
                                <div class="mt8">
                                    <span class="badge rounded-pill text-bg-success">
                                        <field name="records_processed"/> OK
                                    </span>
                                    <t t-if="record.records_failed.raw_value &gt; 0">
                                        <span class="badge rounded-pill text-bg-danger ms-1">
                                            <field name="records_failed"/> Fallas
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_plows_pos_sync_job_form" model="ir.ui.view">
        <field name="name">plows.pos.sync.job.form</field>
        <field name="model">plows.pos.sync.job</field>
        <field name="arch" type="xml">
            <form string="Sincronización Job">
                <header>
                    <button name="action_queue_job" type="object" string="Iniciar Sincronización" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_retry" type="object" string="Re-procesar Job" class="oe_highlight" invisible="state not in ['failed', 'partial_failed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detalles del Proceso">
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                            <field name="global_progress" widget="progressbar"/>
                        </group>
                        <group string="Resultados">
                            <field name="total_records"/>
                            <field name="processed_records"/>
                            <field name="records_failed" decoration-danger="records_failed &gt; 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Modelos" name="sync_tasks">
                            <field name="task_ids" readonly="1">
                                <list>
                                    <field name="catalog_name"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'completed'"
                                           decoration-info="state == 'in_progress'"
                                           decoration-warning="state == 'retrying'"
                                           decoration-danger="state == 'failed'"/>
                                    <field name="processed_records"/>
                                    <field name="total_records"/>
                                    <field name="current_page"/>
                                    <field name="current_page_retries"/>
                                    <field name="progress_percentage" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logs de Sincronización" name="sync_logs">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="level" widget="badge"
                                           decoration-danger="level == 'error'"
                                           decoration-warning="level == 'warning'"
                                           decoration-info="level == 'info'"/>
                                    <field name="phase"/>
                                    <field name="message"/>
                                    <field name="record_ref"/>
                                </list>
                            </field>
                        </page>
                        <page string="Resumen de Errores / Reintentos" name="error_summary" invisible="not error_summary">
                            <field name="error_summary" readonly="1"/>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda y Filtros -->
    <record id="view_plows_pos_sync_job_search" model="ir.ui.view">
        <field name="name">plows.pos.sync.job.search</field>
        <field name="model">plows.pos.sync.job</field>
        <field name="arch" type="xml">
            <search string="Buscar Jobs">
                <field name="name"/>
                <filter string="Fallados" name="failed_jobs" domain="[('state', '=', 'failed')]"/>
                <filter string="En Ejecución" name="running_jobs" domain="[('state', '=', 'running')]"/>
                <filter string="Completados" name="done_jobs" domain="[('state', '=', 'done')]"/>
                <filter string="Con Errores en Logs" name="with_errors" domain="[('log_ids.level', '=', 'error')]"/>
                <filter string="Con Advertencias en Logs" name="with_warnings" domain="[('log_ids.level', '=', 'warning')]"/>
                <group>
                    <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_plows_pos_sync_job" model="ir.actions.act_window">
        <field name="name">Historial de Sincronización</field>
        <field name="res_model">plows.pos.sync.job</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_plows_pos_sync_job_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Historial de sincronización limpio.
            </p>
            <p>
                Aquí se detallarán los lotes de datos leídos desde el POS y procesados en el ORM.
            </p>
        </field>
    </record>
</odoo>
