<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List (Detalle de Documentos) -->
    <record id="view_plows_receivable_cxc_tree" model="ir.ui.view">
        <field name="name">plows.receivable.cxc.tree</field>
        <field name="model">plows.receivable.cxc</field>
        <field name="arch" type="xml">
            <list string="Cuentas por Cobrar (Detallado)" create="0">
                <header>
                    <button name="action_sync_receivables" 
                            string="Actualizar" 
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-refresh"
                            display="always"/>
                </header>
                <field name="cliente_plows_nombre" string="Cliente"/>
                <field name="cliente_asociado_nombre" string="Cliente Asociado"/>
                <field name="no_remision" string="No. Remisión"/>
                <field name="serie_folio" string="Serie / Folio"/>
                <field name="fecha_factura" string="Fecha Factura" widget="date"/>
                <field name="fecha_vencimiento" string="Fecha Límite Pago" widget="date"/>
                <field name="total_factura" string="Total Factura" sum="Total"/>
                <field name="total_nc" string="Total N.C." sum="Total NC"/>
                <field name="saldo_pendiente" string="Saldo Pendiente" sum="Total Saldo"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario de Cuentas por Cobrar (Solo Lectura) -->
    <record id="view_plows_receivable_cxc_form" model="ir.ui.view">
        <field name="name">plows.receivable.cxc.form</field>
        <field name="model">plows.receivable.cxc</field>
        <field name="arch" type="xml">
            <form string="Cuenta por Cobrar" create="false" edit="false">
                <header>
                    <button name="action_sync_receivables" 
                            string="Actualizar" 
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-refresh"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="cliente_plows_nombre" string="Cliente"/>
                        <h1>
                            <field name="cliente_plows_nombre" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identificación y Folios">
                            <field name="cliente_plows_id" readonly="1"/>
                            <field name="cliente_asociado_id" readonly="1"/>
                            <field name="cliente_asociado_nombre" readonly="1"/>
                            <field name="almacen_mov_id" readonly="1"/>
                            <field name="factura_id_plows" readonly="1"/>
                            <field name="no_remision" readonly="1"/>
                            <field name="serie_folio" readonly="1"/>
                            <field name="no_pago" readonly="1"/>
                        </group>
                        <group string="Fechas y Montos">
                            <field name="fecha_factura" readonly="1" widget="date"/>
                            <field name="fecha_vencimiento" readonly="1" widget="date"/>
                            <field name="dias_atraso" string="Antigüedad (días)" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_factura" readonly="1"/>
                            <field name="total_nc" readonly="1"/>
                            <field name="total_pagado" readonly="1"/>
                            <field name="saldo_pendiente" readonly="1"/>
                            <field name="bucket_antiguedad" readonly="1"/>
                        </group>
                    </group>
                    <group string="Relaciones en Odoo">
                        <field name="partner_id" readonly="1"/>
                        <field name="pos_order_id" readonly="1"/>
                        <field name="move_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Pivot (General Agrupada por Cliente y Medidas de Buckets) -->
    <record id="view_plows_receivable_cxc_pivot" model="ir.ui.view">
        <field name="name">plows.receivable.cxc.pivot</field>
        <field name="model">plows.receivable.cxc</field>
        <field name="arch" type="xml">
            <pivot string="Resumen Cuentas por Cobrar" disable_linking="false" js_class="plows_cxc_pivot_view">
                <field name="cliente_plows_nombre" type="row"/>
                <field name="saldo_pendiente" string="Total" type="measure"/>
                <field name="total_vencido" string="Total Vencido" type="measure"/>
                <field name="vencido_60_plus" string="+60 vencido" type="measure"/>
                <field name="vencido_31_60" string="31-60 vencido" type="measure"/>
                <field name="vencido_16_30" string="16-30 vencido" type="measure"/>
                <field name="vencido_8_15" string="8-15 vencido" type="measure"/>
                <field name="vencido_1_7" string="1-7 vencido" type="measure"/>
                <field name="total_por_vencer" string="Total Por Vencer" type="measure"/>
                <field name="hoy" string="Hoy" type="measure"/>
                <field name="vencer_1_7" string="1-7 por vencer" type="measure"/>
                <field name="vencer_8_15" string="8-15 por vencer" type="measure"/>
                <field name="vencer_16_30" string="16-30 por vencer" type="measure"/>
                <field name="vencer_31_60" string="31-60 por vencer" type="measure"/>
                <field name="vencer_60_plus" string="+60 por vencer" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vista Search (Filtros y Búsqueda) -->
    <record id="view_plows_receivable_cxc_search" model="ir.ui.view">
        <field name="name">plows.receivable.cxc.search</field>
        <field name="model">plows.receivable.cxc</field>
        <field name="arch" type="xml">
            <search string="Buscar Cuentas por Cobrar">
                <field name="cliente_plows_nombre" string="Cliente"/>
                <field name="no_remision" string="No. Remisión"/>
                <field name="serie_folio" string="Serie / Folio"/>
                <field name="partner_id" string="Contacto Odoo"/>
                
                <filter string="Por Vencer" name="filter_por_vencer" domain="[('tipo_vencimiento', '=', 'por_vencer')]"/>
                <filter string="Vencidos" name="filter_vencidos" domain="[('tipo_vencimiento', '=', 'vencido')]"/>
                <separator/>
                <filter string="Tiene Contacto Odoo" name="filter_has_partner" domain="[('partner_id', '!=', False)]"/>
                <filter string="Tiene Ticket Odoo" name="filter_has_ticket" domain="[('pos_order_id', '!=', False)]"/>

                <filter string="Agrupar por Cliente" name="group_cliente" context="{'group_by': 'cliente_plows_nombre'}"/>
                <filter string="Agrupar por Contacto Odoo" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Agrupar por Rango Antigüedad" name="group_bucket" context="{'group_by': 'bucket_antiguedad'}"/>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana para Cuentas por Cobrar -->
    <record id="action_plows_receivable_cxc" model="ir.actions.act_window">
        <field name="name">Cuentas por Cobrar</field>
        <field name="res_model">plows.receivable.cxc</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="context">{'create': False, 'search_default_group_cliente': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay cuentas por cobrar registradas.
            </p>
            <p>
                Haga clic en el botón <b>"Actualizar"</b> para descargar la información actualizada desde PLOWS.
            </p>
        </field>
    </record>

    <!-- Acción de Servidor para Sincronizar CxC (Ordenada con sequence=1 para aparecer arriba de Exportar todo) -->
    <!-- <record id="action_server_sync_receivables" model="ir.actions.server">
        <field name="name">Actualizar CxC<</field>
        <field name="model_id" ref="model_plows_receivable_cxc"/>
        <field name="binding_model_id" ref="model_plows_receivable_cxc"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form,pivot</field>
        <field name="sequence">1</field>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_receivables()</field>
    </record> -->
    <record id="action_server_sync_receivables" model="ir.actions.server">
    <field name="name">Actualizar CxC</field>
    <field name="model_id" ref="model_plows_receivable_cxc"/>
    <field name="binding_model_id" ref="model_plows_receivable_cxc"/>
    <field name="binding_type">action</field>
    <field name="binding_view_types">list,form,pivot</field>
    <field name="sequence">1</field>
    <field name="state">code</field>
    <field name="code">action = model.action_sync_receivables()</field>
</record>
</odoo>
