<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List (Detalle de Documentos) -->
    <record id="view_plows_receivable_cxc_tree" model="ir.ui.view">
        <field name="name">plows.receivable.cxc.tree</field>
        <field name="model">plows.receivable.cxc</field>
        <field name="arch" type="xml">
            <list string="Cuentas por Cobrar (Detallado)">
                <header>
                    <button name="action_sync_receivables" 
                            string="Sincronizar CxC" 
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-refresh"/>
                </header>
                <field name="cliente_plows_nombre" string="Cliente"/>
                <field name="cliente_asociado_nombre" string="Cliente Asociado"/>
                <field name="partner_id" string="Contacto Odoo"/>
                <field name="no_remision" string="No. Remisión"/>
                <field name="serie_folio" string="Serie / Folio"/>
                <field name="fecha_factura" string="Fecha Factura"/>
                <field name="fecha_vencimiento" string="Fecha Límite Pago"/>
                <field name="tipo_vencimiento" string="Tipo Vencimiento"/>
                <field name="bucket_antiguedad" string="Antigüedad"/>
                <field name="total_factura" string="Total Factura" sum="Total"/>
                <field name="total_nc" string="Total N.C." sum="Total NC"/>
                <field name="saldo_pendiente" string="Saldo Pendiente" sum="Total Saldo"/>
                <field name="pos_order_id" string="Ticket Odoo"/>
            </list>
        </field>
    </record>

    <!-- Vista Pivot (General Agrupada por Cliente y Buckets) -->
    <record id="view_plows_receivable_cxc_pivot" model="ir.ui.view">
        <field name="name">plows.receivable.cxc.pivot</field>
        <field name="model">plows.receivable.cxc</field>
        <field name="arch" type="xml">
            <pivot string="Resumen Cuentas por Cobrar" disable_linking="false">
                <field name="cliente_plows_nombre" type="row"/>
                <field name="tipo_vencimiento" type="col"/>
                <field name="bucket_antiguedad" type="col"/>
                <field name="saldo_pendiente" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vista Search (Filtros y Búsqueda) -->
    <record id="view_plows_receivable_cxc_search" model="ir.ui.view">
        <field name="name">plows.receivable.cxc.search</field>
        <field name="model">plows.receivable.cxc</field>
        <field name="arch" type="xml">
            <search string="Buscar Cuentas por Cobrar">
                <field name="cliente_plows_nombre" string="Cliente"/>
                <field name="no_remision" string="No. Remisión"/>
                <field name="serie_folio" string="Serie / Folio"/>
                <field name="partner_id" string="Contacto Odoo"/>
                
                <filter string="Por Vencer" name="filter_por_vencer" domain="[('tipo_vencimiento', '=', 'por_vencer')]"/>
                <filter string="Vencidos" name="filter_vencidos" domain="[('tipo_vencimiento', '=', 'vencido')]"/>
                <separator/>
                <filter string="Tiene Contacto Odoo" name="filter_has_partner" domain="[('partner_id', '!=', False)]"/>
                <filter string="Tiene Ticket Odoo" name="filter_has_ticket" domain="[('pos_order_id', '!=', False)]"/>

                <filter string="Agrupar por Cliente" name="group_cliente" context="{'group_by': 'cliente_plows_nombre'}"/>
                <filter string="Agrupar por Contacto Odoo" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Agrupar por Tipo Vencimiento" name="group_tipo" context="{'group_by': 'tipo_vencimiento'}"/>
                <filter string="Agrupar por Rango Antigüedad" name="group_bucket" context="{'group_by': 'bucket_antiguedad'}"/>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana para Cuentas por Cobrar -->
    <record id="action_plows_receivable_cxc" model="ir.actions.act_window">
        <field name="name">Cuentas por Cobrar</field>
        <field name="res_model">plows.receivable.cxc</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay cuentas por cobrar registradas.
            </p>
            <p>
                Haga clic en el botón <b>"Sincronizar CxC"</b> para descargar la información actualizada desde PLOWS.
            </p>
        </field>
    </record>
</odoo>
