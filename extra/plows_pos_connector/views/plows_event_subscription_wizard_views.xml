<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Formulario para Asistente Modal de Suscripción de Eventos -->
    <record id="view_plows_event_subscription_wizard_form" model="ir.ui.view">
        <field name="name">plows.pos.event.subscription.wizard.form</field>
        <field name="model">plows.pos.event.subscription.wizard</field>
        <field name="arch" type="xml">
            <form string="Catálogo de Suscripción de Eventos">
                <sheet>
                    <div class="o_setting_right_pane mb16">
                        <p class="text-muted">
                            Selecciona los eventos específicos en los que deseas recibir notificaciones en tiempo real desde la API de Plows POS.
                        </p>
                    </div>
                    <group string="Catálogos y Maestros">
                        <group>
                            <field name="event_products"/>
                            <field name="event_customers"/>
                            <field name="event_suppliers"/>
                        </group>
                        <group>
                            <field name="event_warehouses"/>
                            <field name="event_employees"/>
                            <field name="event_taxes"/>
                            <field name="event_payments"/>
                        </group>
                    </group>
                    <group string="Operaciones y Ventas">
                        <group>
                            <field name="event_closures"/>
                            <field name="event_tickets"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_subscription" string="Guardar y Registrar en API" type="object" class="btn-primary" icon="fa-check"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana para el Wizard (Target Modal / New) -->
    <record id="action_plows_event_subscription_wizard" model="ir.actions.act_window">
        <field name="name">Suscripción de Eventos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">plows.pos.event.subscription.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
