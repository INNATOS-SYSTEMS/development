<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Secuencia para Folios de Egresos -->
    <record id="seq_plows_pos_expense" model="ir.sequence">
        <field name="name">Plows POS Egreso Folio</field>
        <field name="code">plows.pos.expense</field>
        <field name="prefix">EGR-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Secuencia para Folios de Inventario -->
    <record id="seq_plows_pos_inventory" model="ir.sequence">
        <field name="name">Plows POS Inventario Folio</field>
        <field name="code">plows.pos.inventory</field>
        <field name="prefix">INV-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
