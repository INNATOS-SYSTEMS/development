<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_traceability" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.traceability</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='owner_stored_products']" position="after">
                <setting id="x_additional_expiration_setting" 
                         title="Define los años a sumar cuando no existen componentes formulados." 
                         help="Años adicionales para productos sin componentes formulados">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="additional_expiration_years" string="Años adicionales "/>
                            
                            <div class="text-muted">
                                Se sumarán a la fecha de caducidad de los lotes fabricados si no existen componentes formulados.
                            </div>
                            <field name="additional_expiration_years" class="oe_inline"/><span class="ms-2">Años</span>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>