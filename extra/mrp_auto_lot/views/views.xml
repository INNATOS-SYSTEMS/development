<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_is_formulated" model="ir.ui.view">
        <field name="name">product.template.form.is.formulated</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']//group[@name='inventory']" position="inside">
                <group name="quality_and_formula" string="Formulación">
                    <field name="is_formulated"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_form_global_seq" model="ir.ui.view">
        <field name="name">stock.lot.form.global.seq</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="global_sequence_val"/>
            </xpath>
        </field>
    </record>
</odoo>
