<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_split_form_inherit" model="ir.ui.view">
        <field name="name">mrp.production.split.form.inherit</field>
        <field name="model">mrp.production.split</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_split_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="alert alert-warning d-flex align-items-center" role="alert" invisible="not warning_message" style="margin-bottom: 20px; font-size: 14px;">
                    <i class="fa fa-exclamation-triangle me-2" style="font-size: 20px;"/>
                    <field name="warning_message" widget="html" readonly="1" class="mb-0"/>
                </div>
            </xpath>

            <!-- CAMBIO: Añadimos la columna lot_id al listado de particiones detalladas, visible únicamente cuando el wizard es detonado por nuestro aviso de trazabilidad -->
            <xpath expr="//field[@name='production_detailed_vals_ids']/list/field[@name='quantity']" position="before">
                <field name="lot_id" column_invisible="parent.warning_message == False" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
